# Build tooling only; new script areas are excluded by default
# EAS checks directory paths without a trailing slash while copying
/script/*
!/script/build
!/script/shared

# Local environment files; examples and templates must contain no secrets
.env*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Local credentials; use protected environment/file variables for builds
credentials.json
credentials.*.json
*.credentials.json
service-account*.json
*.service-account.json
service_account*.json
*.service_account.json
*-firebase-adminsdk-*.json

# TypeScript
*.tsbuildinfo

