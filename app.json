{
  "expo": {
    "name": "AROW-mobile",
    "slug": "AROW-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arowmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.leooojrrr.AROWmobile",
      "icon": "./assets/images/android-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": { "backgroundColor": "#0A0A0A" }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez AROW Mobile à utiliser votre position pendant l’utilisation de l’app."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset",
      "expo-sqlite",
      "./modules/arow-mock-location/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46f81405-3188-4f66-8d39-ad044eb24d38"
      }
    }
  }
}
